{
  "name": "pixel-tides",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Pixel Tides - a cozy multiplayer pixel-art fishing adventure",
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "typecheck": "tsc -p client/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "tsup server/src/index.ts --format cjs --platform node --target node22 --external node:sqlite --out-dir dist/server --clean && node -e \"require('fs').writeFileSync('dist/server/package.json', JSON.stringify({type:'commonjs'}))\"",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "start": "node dist/server/index.cjs",
    "test": "tsx tests/integration.ts",
    "test:mp": "tsx tests/multiplayer.ts",
    "test:expansion": "tsx tests/expansion.ts"
  },
  "dependencies": {
    "@colyseus/schema": "2.0.37",
    "colyseus": "0.15.57",
    "colyseus.js": "0.15.28",
    "cors": "2.8.5",
    "dotenv": "^18.0.10",
    "express": "4.21.2",
    "pg": "8.13.1",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "concurrently": "9.1.2",
    "tsup": "8.3.5",
    "tsx": "4.23.15",
    "typescript": "5.7.2",
    "vite": "6.0.7"
  }
}
