# Pixel Tides environment
# Copy this file to .env and adjust as needed.

# Port for the Colyseus + Express server. Production serves the built client too.
PORT=2567

# Optional PostgreSQL / Supabase connection string.
# When omitted, Pixel Tides uses a zero-config SQLite database at server/data/pixel-tides.db.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pixel_tides
# PGSSL=true

# Optional custom SQLite location.
# SQLITE_PATH=server/data/pixel-tides.db

# Allow a specific frontend origin in development (default: reflect request origin).
# CLIENT_ORIGIN=http://localhost:5173

# Set to production when serving the built client.
# NODE_ENV=production
